# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=DISCORD_TOKEN
# Set to `true` to register slash commands per-guild only (faster propagation
# during dev). Set to `false` for global commands in production.
DISCORD_GUILD_COMMANDS_ONLY=true
# When `true`, the bot routes free-form thread messages to the running session
# as input. Off by default (admins must opt in per deployment).
ENABLE_MESSAGE_CONTENT_INPUT=false
# Comma-separated guild IDs the bot serves. Empty refuses every guild (fail closed);
# the bot leaves any unlisted guild it is invited to.
ALLOWED_GUILD_IDS=


# ─── Database / Redis ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://discode:discode@localhost:5432/discode
REDIS_URL=redis://localhost:6379/0


# ─── Secrets ────────────────────────────────────────────────────────────────
# Comma-separated list of Fernet keys (MultiFernet). The first key encrypts;
# every key is tried for decryption. During rotation, set "<new>,<old>" until
# all in-flight ciphertext is re-encrypted.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEPLOYMENT_SECRET_KEY=DEPLOYMENT_SECRET_KEY


# ─── Runner ─────────────────────────────────────────────────────────────────
RUNNER_HOST_ID=local-dev
SESSION_CREATE_TIMEOUT_SECONDS=60
RUNNER_HEARTBEAT_INTERVAL_SECONDS=5
RUNNER_HEARTBEAT_STALE_SECONDS=15
# On SIGTERM/SIGINT the runner stops admitting input and lets in-flight tool turns
# finish for this long before killing them. A second signal skips the wait. Set your
# supervisor's stop timeout (systemd TimeoutStopSec, Compose stop_grace_period) higher.
RUNNER_DRAIN_TIMEOUT_SECONDS=25

# Runner control API — the loopback HTTP server the runner uses to receive
# its own outbound replies and serve diff/preflight/canonicalize endpoints.
# Loopback or RFC1918/link-local/ULA private addresses only; public binds
# are refused at startup.
RUNNER_CONTROL_BIND=127.0.0.1:8788
# Bearer token for control-API auth. REQUIRED on every bind, including loopback.
# Agents share the host and can reach loopback services.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
RUNNER_CONTROL_AUTH=

# Only trusted_host is implemented. All users/agents share runner OS privileges.
# Legacy isolation names parse for migration but are rejected at execution.
# Use a dedicated disposable host with fully trusted operators.
SESSION_ISOLATION_MODE=trusted_host


# ─── Redis consumer groups ──────────────────────────────────────────────────
# See docs/operations/incident-playbook.md for tuning guidance.
RUNNER_JOB_PEL_IDLE_MS=60000
RUNNER_JOB_MAX_DELIVERIES=5
DISPATCHER_PEL_IDLE_MS=60000
DISPATCHER_MAX_DELIVERIES=5

# Producer-side outbox.
OUTBOX_BATCH_SIZE=64
OUTBOX_IDLE_SLEEP_MS=200
OUTBOX_MAX_ATTEMPTS=50
OUTBOX_BASE_BACKOFF_MS=100
OUTBOX_MAX_BACKOFF_MS=60000

# Stuck-state watchdog.
RESUME_STUCK_THRESHOLD_SECONDS=300
# Sessions still 'stopping' after this long (stop job lost, runner gone) become 'stopped'.
STOP_STUCK_THRESHOLD_SECONDS=600


# ─── Idempotency ────────────────────────────────────────────────────────────
# Retention for delivered turn output/resume payloads; execution tombstones remain
# to prevent re-execution. Undelivered/uncertain turns are retained for review.
# Set to "never" to retain delivered payloads indefinitely.
INPUT_IDEMPOTENCY_RETENTION=30d

# Input execution is ordered and fenced with PostgreSQL advisory locks and the turn ledger.


# ─── Lifecycle ──────────────────────────────────────────────────────────────
DEFAULT_IDLE_TIMEOUT_MINUTES=60
DEFAULT_ARCHIVE_TIMEOUT_MINUTES=120
DEFAULT_STOP_TIMEOUT_HOURS=24
EVENT_RETENTION_DAYS=90
ORPHAN_RECOVERY_TTL_HOURS=24


# ─── Rate / size limits ─────────────────────────────────────────────────────
MAX_OUTPUT_BYTES_PER_SESSION_PER_MIN=262144
MAX_INPUT_MESSAGES_PER_SESSION_PER_MIN=20
MAX_INPUT_BYTES_PER_MESSAGE=8192
MAX_INPUT_BYTES_PER_SESSION_PER_MIN=163840


# ─── Metrics (Prometheus format; loopback by default) ───────────────────────
BOT_METRICS_BIND=127.0.0.1:9101
RUNNER_METRICS_BIND=127.0.0.1:9102
DISPATCHER_METRICS_BIND=127.0.0.1:9103
JANITOR_METRICS_BIND=127.0.0.1:9104


# ─── Safety ─────────────────────────────────────────────────────────────────
# Set to 1 and restart processes to halt posts/spawns and cancel active turns.
# Settings are cached: changing this file alone does not update running processes.
EMERGENCY_STOP=0


# ─── Tool authentication ────────────────────────────────────────────────────
# Each CLI authenticates itself; discode forwards the runner's environment to
# allowlisted variables to spawned subprocesses. Pick one method per tool:
#
#   claude    →  `claude login`           writes ~/.claude/    OR set ANTHROPIC_API_KEY
#   codex     →  `codex login`            writes ~/.codex/     OR set OPENAI_API_KEY
#   opencode  →  `opencode auth login`    writes opencode cfg  OR set provider keys
#
# Verify everything is wired with:  uv run python scripts/diag.py
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Platform operators allowed to modify global executable tool definitions.
PLATFORM_ADMIN_USER_IDS=
LOG_LEVEL=INFO
# Postgres pool per process. The runner needs > 2x input concurrency (8) plus headroom.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
JANITOR_SWEEP_INTERVAL_SECONDS=60
REDIS_STREAM_RETENTION_HOURS=24
OUTBOX_RETENTION_DAYS=7
RETENTION_BATCH_SIZE=1000
MAX_ACTIVE_SESSIONS_PER_USER=10
